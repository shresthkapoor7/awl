{
  "name": "awl",
  "version": "0.1.0",
  "private": true,
  "description": "A local workspace for computer use that learns.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src electron scripts index.html vite.config.ts tsconfig.json package.json",
    "test:ui": "npm run build && node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.7",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "playwright-core": "^1.58.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
